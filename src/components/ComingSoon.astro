---
import Icon from "./Icon.astro";
import PageHero from "./PageHero.astro";
import type { IconName } from "./icons";

interface Props {
  kicker: string;
  title: string;
  intro: string;
  /** What will appear on this page once it is filled. */
  items: { icon: IconName; title: string; text: string }[];
  /** Show placeholder photo blocks (for pages that will get photos). */
  photos?: boolean;
}

const { kicker, title, intro, items, photos = false } = Astro.props;
---

<PageHero kicker={kicker} title={title} intro={intro} soon />

<div class="container body">
  {photos && (
    <div class="photos" aria-hidden="true">
      <div class="photo big">
        <Icon name="camera" size={36} strokeWidth={1.5} />
      </div>
      <div class="photo" />
      <div class="photo" />
    </div>
  )}

  <section class="card soon-list" aria-labelledby="straks-titel">
    <h2 class="list-title" id="straks-titel">
      Wat je hier straks vindt
    </h2>
    <ul>
      {items.map((item) => (
        <li>
          <span class="icon-tile small">
            <Icon name={item.icon} size={20} />
          </span>
          <div>
            <p class="item-title">{item.title}</p>
            <p class="item-text">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <div class="cta">
    <p>Hoe sneller de pot vol is, hoe eerder deze pagina gevuld wordt.</p>
    <a class="button" href="/#betalen">
      Naar betalen
      <Icon name="arrowRight" size={20} strokeWidth={2} />
    </a>
  </div>
</div>

<style>
  .body {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 48rem;
    margin-top: 4px;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .photo {
    height: 110px;
    border-radius: 14px;
    background: repeating-linear-gradient(
      135deg,
      #e7efe2 0 12px,
      #eef4ea 12px 24px
    );
  }
  .photo.big {
    grid-column: span 2;
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-moss);
  }
  @media (min-width: 48rem) {
    .photo.big {
      height: 280px;
    }
    .photo {
      height: 160px;
    }
  }

  .soon-list {
    padding: 6px 18px;
  }
  .list-title {
    padding: 14px 0 4px;
    font-family: var(--font);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-moss);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px 0;
  }
  li + li {
    border-top: 1px solid var(--c-line);
  }
  .icon-tile.small {
    width: 40px;
    height: 40px;
  }
  .item-title {
    font-weight: 700;
  }
  .item-text {
    font-size: 0.9375rem;
    color: var(--c-ink-soft);
  }

  .cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cta p {
    padding: 0 4px;
    color: var(--c-ink-soft);
  }
  .cta .button {
    min-height: 52px;
    font-size: 1.0625rem;
  }
  @media (min-width: 48rem) {
    .cta .button {
      align-self: flex-start;
    }
  }
</style>
