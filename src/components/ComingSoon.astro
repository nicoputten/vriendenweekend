---
import Icon from "./Icon.astro";
import Mountains from "./Mountains.astro";
import type { IconName } from "./icons";

interface Props {
  kicker: string;
  title: string;
  intro: string;
  /** What will appear on this page once it is filled. */
  items: { icon: IconName; title: string; text: string }[];
  /** Show placeholder photo blocks (for pages that will get photos). */
  photos?: boolean;
}

const { kicker, title, intro, items, photos = false } = Astro.props;
---

<section class="hero">
  <div class="container hero-text">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="lead">{intro}</p>
    <p>
      <span class="badge">Binnenkort</span>
    </p>
  </div>
  <Mountains />
</section>

<div class="container body">
  {photos && (
    <div class="photos" aria-hidden="true">
      <div class="photo big">
        <Icon name="camera" size={36} strokeWidth={1.5} />
      </div>
      <div class="photo" />
      <div class="photo" />
    </div>
  )}

  <section class="card soon-list" aria-labelledby="straks-titel">
    <h2 class="list-title" id="straks-titel">
      Wat je hier straks vindt
    </h2>
    <ul>
      {items.map((item) => (
        <li>
          <span class="icon-tile small">
            <Icon name={item.icon} size={20} />
          </span>
          <div>
            <p class="item-title">{item.title}</p>
            <p class="item-text">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <div class="cta">
    <p>Hoe sneller de pot vol is, hoe eerder deze pagina gevuld wordt.</p>
    <a class="button" href="/#betalen">
      Naar betalen
      <Icon name="arrowRight" size={20} strokeWidth={2} />
    </a>
  </div>
</div>

<style>
  .hero {
    position: relative;
    background: linear-gradient(
      180deg,
      var(--c-forest-900) 0%,
      var(--c-forest-800) 100%
    );
    color: var(--c-cream);
    overflow: hidden;
  }
  .hero-text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 4px 120px;
  }
  .kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-amber-light);
  }
  h1 {
    color: var(--c-cream);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .lead {
    color: var(--c-on-dark);
    max-width: 40rem;
  }
  @media (min-width: 64rem) {
    .hero-text {
      padding: 56px 0 160px;
      gap: 14px;
    }
    .lead {
      font-size: 1.1875rem;
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 48rem;
    margin-top: 4px;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .photo {
    height: 110px;
    border-radius: 14px;
    background: repeating-linear-gradient(
      135deg,
      #e7efe2 0 12px,
      #eef4ea 12px 24px
    );
  }
  .photo.big {
    grid-column: span 2;
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-moss);
  }
  @media (min-width: 48rem) {
    .photo.big {
      height: 280px;
    }
    .photo {
      height: 160px;
    }
  }

  .soon-list {
    padding: 6px 18px;
  }
  .list-title {
    padding: 14px 0 4px;
    font-family: var(--font);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-moss);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px 0;
  }
  li + li {
    border-top: 1px solid var(--c-line);
  }
  .icon-tile.small {
    width: 40px;
    height: 40px;
  }
  .item-title {
    font-weight: 700;
  }
  .item-text {
    font-size: 0.9375rem;
    color: var(--c-ink-soft);
  }

  .cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cta p {
    padding: 0 4px;
    color: var(--c-ink-soft);
  }
  .cta .button {
    min-height: 52px;
    font-size: 1.0625rem;
  }
  @media (min-width: 48rem) {
    .cta .button {
      align-self: flex-start;
    }
  }
</style>
