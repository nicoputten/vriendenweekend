---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { packingList } from "../config/packing-list";

const ids = packingList.categories.flatMap((category) =>
  category.items.map((item) => item.id),
);
---

<Base title="Paklijst">
  <PageHero
    kicker={packingList.kicker}
    title="Paklijst"
    intro={packingList.intro}
  />

  <div
    class="container body"
    data-packing-list
    data-storage-key={packingList.storageKey}
  >
    <div class="card progress">
      <p class="progress-text">
        <span data-progress-done>0</span> van {ids.length} ingepakt
      </p>
      <div
        class="bar"
        role="progressbar"
        aria-label="Voortgang paklijst"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div class="bar-fill" data-progress-bar></div>
      </div>
      <p class="progress-percent">
        <span data-progress-percent>0</span>%
      </p>
    </div>

    <div class="groups">
      {packingList.categories.map((category, index) => (
        <section class="group" aria-labelledby={`categorie-${index}`}>
          <h2 id={`categorie-${index}`}>{category.name}</h2>
          <ul class="card">
            {category.items.map((item) => (
              <li>
                <label>
                  <input type="checkbox" name="paklijst" value={item.id} />
                  <span class="text">
                    <span class="label">{item.label}</span>
                    {"hint" in item && item.hint && (
                      <span class="hint">{item.hint}</span>
                    )}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 4px;
    padding-bottom: 40px;
  }

  .progress {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "text percent"
      "bar bar";
    gap: 10px;
    padding: 16px 18px;
    font-weight: 600;
  }
  .progress-text {
    grid-area: text;
  }
  .progress-percent {
    grid-area: percent;
    color: var(--c-moss);
  }
  .bar {
    grid-area: bar;
    height: 10px;
    border-radius: 999px;
    background: var(--c-fern-50);
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--c-moss);
    transition: width 0.2s ease;
  }

  .groups {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .group h2 {
    padding: 0 4px;
    font-size: 1.3125rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 4px 0;
  }
  li + li {
    border-top: 1px solid var(--c-line);
  }
  label {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    min-height: 48px;
    padding: 12px 16px;
    cursor: pointer;
  }
  input {
    flex: none;
    width: 22px;
    height: 22px;
    margin: 1px 0 0;
    accent-color: var(--c-moss);
    cursor: pointer;
  }
  input:focus-visible {
    outline: 3px solid var(--c-amber);
    outline-offset: 3px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .label {
    font-weight: 500;
  }
  input:checked + .text .label {
    text-decoration: line-through;
    color: var(--c-ink-soft);
  }
  .hint {
    font-size: 0.875rem;
    color: var(--c-ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-fill {
      transition: none;
    }
  }

  @media (min-width: 64rem) {
    .body {
      gap: 28px;
      margin-top: 8px;
      padding-bottom: 88px;
    }
    .progress {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "text bar percent";
      align-items: center;
      gap: 24px;
      padding: 20px 24px;
      font-size: 1.125rem;
      font-weight: 700;
    }
    .progress-percent {
      font-size: 1rem;
    }
    .bar {
      height: 12px;
    }
    .groups {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
      align-items: start;
    }
    .group {
      gap: 10px;
    }
    .group h2 {
      padding: 0;
      font-size: 1.5rem;
    }
    label {
      padding: 14px 20px;
    }
    input {
      margin-top: 2px;
    }
    .hint {
      font-size: 0.9375rem;
    }
  }
</style>

<script>
  import { parseChecked, progress, serializeChecked } from "../lib/packing";

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-packing-list]",
  )) {
    const key = root.dataset.storageKey!;
    const boxes = [
      ...root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'),
    ];
    const ids = boxes.map((box) => box.value);
    const done = root.querySelector<HTMLElement>("[data-progress-done]")!;
    const percent = root.querySelector<HTMLElement>("[data-progress-percent]")!;
    const bar = root.querySelector<HTMLElement>('[role="progressbar"]')!;
    const fill = root.querySelector<HTMLElement>("[data-progress-bar]")!;

    // Storage can be unavailable (private mode, blocked cookies): the list
    // then still works, it is just not remembered.
    const load = () => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const save = (value: string) => {
      try {
        localStorage.setItem(key, value);
      } catch {
        /* not remembered, see above */
      }
    };

    const update = () => {
      const checked = new Set(
        boxes.filter((box) => box.checked).map((box) => box.value),
      );
      const result = progress(checked, ids);
      done.textContent = String(result.done);
      percent.textContent = String(result.percent);
      bar.setAttribute("aria-valuenow", String(result.percent));
      fill.style.width = `${result.percent}%`;
      return checked;
    };

    const stored = parseChecked(load(), ids);
    for (const box of boxes) box.checked = stored.has(box.value);
    update();

    root.addEventListener("change", (e) => {
      if (!(e.target instanceof HTMLInputElement)) return;
      save(serializeChecked(update(), ids));
    });
  }
</script>
