---
import Base from "../layouts/Base.astro";
import ComingSoon from "../components/ComingSoon.astro";
---

<Base title="Programma">
  <ComingSoon
    kicker="Vrijdag t/m maandag"
    title="Programma"
    intro="Een los programma per dag, met kookavonden en de Vriendenweekend Quiz."
    items={[
      {
        icon: "calendar",
        title: "Per dag",
        text: "Wat er op vrijdag, zaterdag, zondag en maandag gebeurt.",
      },
      { icon: "food", title: "Kookavonden", text: "Wie op welke avond kookt." },
      {
        icon: "dice",
        title: "Spellen en de quiz",
        text: "Bordspellen, buitenspellen en de quiz.",
      },
    ]}
  />
</Base>
